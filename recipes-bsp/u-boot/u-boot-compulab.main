DESCRIPTION = "CompuLab i.MX8 U-Boot"
require recipes-bsp/u-boot/u-boot.inc
require u-boot-compulab-env.inc
require u-boot-compulab/imx8mp.inc
require u-boot-compulab_${PV}.inc

PROVIDES += "u-boot imx-boot"

LICENSE = "GPL-2.0-or-later"
LIC_FILES_CHKSUM = "file://Licenses/gpl-2.0.txt;md5=b234ee4d69f5fce4486a80fdaf4a4263"

DEPENDS += " flex-native bison-native bc-native dtc-native gnutls-native python3-setuptools-native "

SPL_BINARY = ""
UUU_BOOTLOADER = "1"
UBOOT_VERSION_EXTENSION = "-${CL_RELEASE}"
LOCALVERSION = "${UBOOT_VERSION_EXTENSION}"

inherit fsl-u-boot-localversion imx-boot-container uuu_bootloader_tag

UBOOT_COMPULAB_FIRMWARE_DEPLOY = "${DEPLOYDIR}/u-boot-compulab-firmware"

do_deploy[depends] += " \
    ${@' '.join('%s:do_deploy' % recipe for recipe in (d.getVar('IMX_EXTRA_FIRMWARE') or '').split())} \
    ${IMX_DEFAULT_ATF_PROVIDER}:do_deploy \
    optee-os:do_deploy \
"

do_deploy:append () {
    if [ -f "${DEPLOYDIR}/flash.bin" ]; then
        ln -sf flash.bin ${DEPLOYDIR}/imx-boot
    fi

    install -d "${UBOOT_COMPULAB_FIRMWARE_DEPLOY}"

    gzip -9n -c "${DEPLOY_DIR_IMAGE}/${ATF_MACHINE_NAME}" \
        > "${UBOOT_COMPULAB_FIRMWARE_DEPLOY}/bl31.bin.gz"
    gzip -9n -c "${DEPLOY_DIR_IMAGE}/tee.bin" \
        > "${UBOOT_COMPULAB_FIRMWARE_DEPLOY}/tee.bin.gz"

    for ddr_firmware in ${DDR_FIRMWARE_NAME}; do
        gzip -9n -c "${DEPLOY_DIR_IMAGE}/${ddr_firmware}" \
            > "${UBOOT_COMPULAB_FIRMWARE_DEPLOY}/${ddr_firmware}.gz"
    done
}

do_install() {
    install -d ${D}/boot
    install -m 0644 ${KCONFIG_CONFIG_ROOTDIR}/flash.bin ${D}/boot/
    install -m 0644 ${KCONFIG_CONFIG_ROOTDIR}/flash.bin \
        ${D}/boot/flash.bin.tagged
    stat -L -cUUUBURNXXOEUZX7+A-XY5601QQWWZ%sEND \
        ${D}/boot/flash.bin.tagged >> ${D}/boot/flash.bin.tagged

    ln -sf flash.bin ${D}/boot/flash.bin-${MACHINE}
    ln -sf flash.bin.tagged ${D}/boot/flash.bin-${MACHINE}.tagged
}

FILES:${PN} = " \
    /boot/flash* \
"

EXTRA_OEMAKE += 'HOSTCC="${BUILD_CC} ${BUILD_CPPFLAGS}" \
                 HOSTLDFLAGS="${BUILD_LDFLAGS}" \
                 HOSTSTRIP=true'

rm_work[noexec] = "1"

PACKAGE_ARCH = "${MACHINE_ARCH}"
COMPATIBLE_MACHINE = "(compulab-mx8mp)"
