DESCRIPTION = "CompuLab i.MX8 U-Boot"
require recipes-bsp/u-boot/u-boot.inc
require u-boot-compulab-env.inc
require u-boot-compulab_${PV}.inc
require u-boot-compulab/imx8mp.inc

PROVIDES += "u-boot"

LICENSE = "GPLv2+"
LIC_FILES_CHKSUM = "file://Licenses/gpl-2.0.txt;md5=b234ee4d69f5fce4486a80fdaf4a4263"

DEPENDS += "flex-native bison-native bc-native dtc-native gnutls-native"

S = "${WORKDIR}/git"
B = "${WORKDIR}/build"

SPL_BINARY = ""
UUU_BOOTLOADER = "1"
UBOOT_VERSION_EXTENSION = "-${CL_RELEASE}-${DRAM_CONF}"

inherit fsl-u-boot-localversion imx-boot-container uuu_bootloader_tag

do_compile:prepend () {
    export SOURCE_DATE_EPOCH=$(date +%s)
    for _config in ${UBOOT_MACHINE}; do
        echo  "CONFIG_LOCALVERSION=\"${UBOOT_VERSION_EXTENSION}\"" >> ${B}/${_config}/.config
    done
}

do_deploy:append () {
    for file in flash.bin.tagged flash.bin;do
    if [ -f "${DEPLOYDIR}/${file}" ]; then
        ln -sf ${file} ${DEPLOYDIR}/${file}.${DRAM_CONF}
    fi
    done
    if [ -f "${DEPLOYDIR}/flash.bin" ]; then
        ln -sf flash.bin ${DEPLOYDIR}/imx-boot
    fi
}

do_install() {
    uboot_machine="${@d.getVar('UBOOT_MACHINE').replace(' ', '')}"
    install -d ${D}/boot
    install -m 0644 ${B}/${uboot_machine}/flash.bin ${D}/boot/
    ln -sf flash.bin ${D}/boot/flash.bin-${MACHINE}-${DRAM_CONF}
}

FILES:${PN} = " \
    /boot/flash* \
"

EXTRA_OEMAKE += 'HOSTCC="${BUILD_CC} ${BUILD_CPPFLAGS}" \
                 HOSTLDFLAGS="${BUILD_LDFLAGS}" \
                 HOSTSTRIP=true'

rm_work[noexec] = "1"

PACKAGE_ARCH = "${MACHINE_ARCH}"
COMPATIBLE_MACHINE = "(compulab-mx8mp)"
