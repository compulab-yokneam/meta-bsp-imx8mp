#!/bin/bash -e

MACHINE=${MACHINE:-ucm-imx8m-plus}
DISTRO=${DISTRO:-fsl-imx-xwayland}
EULA=1
T="../sources/meta-bsp-imx8mp/templates"
M="../sources/meta-bsp-imx8mp/tools/${MACHINE}"

BD=$(cat <<< $@ | awk '$0=$NF')

function fix_fsl_imx_base() {
    F=${BUILDDIR}/../sources/meta-imx/meta-imx-sdk/conf/distro/include/fsl-imx-base.inc
    sed -i 's/\(^DISTRO_FEATURES:remove = ".*\)\(pulseaudio\)\(.*"\)/\1\3/g' ${F}
}

function mach_function() {
    [[ -d ${M} ]] || return 0
    for _file in ${M}/*;do
        source ${_file}
    done
}

function temp_function() {
    for _d in ${T}/*;do
        _file=$(basename ${_d})
        [[ "${_file}" == "multiconfig" ]] && continue
        for _f in ${_d}/*;do
        file ${_f} | grep -iq "shell" && source ${_f} >> conf/${_file} || {
cat << eof >> conf/${_file}

# Included from ${_f}
$(cat ${_f})

eof
    }
        done;
    done
}

function multiconfig_function() {
    local source_dir="${T}/multiconfig"
    local destination_dir="${BUILDDIR}/conf/multiconfig"
    local destination_file

    [[ -d "${source_dir}" ]] || return 0

    install -d "${destination_dir}"
    for _file in "${source_dir}"/*.conf;do
        [[ -e "${_file}" ]] || continue
        destination_file="${destination_dir}/$(basename "${_file}")"
        [[ -e "${destination_file}" ]] && continue
        install -m 0644 "${_file}" "${destination_file}"
    done
}

if [[ -d ${BD} ]];then

echo "Back to the build environment ${BD}"
. setup-environment ${BD}
multiconfig_function

else

. imx-setup-release.sh -b $@

    temp_function
    multiconfig_function
    mach_function
    fix_fsl_imx_base
fi
