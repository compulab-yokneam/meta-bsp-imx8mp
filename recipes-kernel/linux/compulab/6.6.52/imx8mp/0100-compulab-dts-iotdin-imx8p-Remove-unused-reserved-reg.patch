From bc63d7223f6f8b02ecf0c1be55a9e14257c5b7f1 Mon Sep 17 00:00:00 2001
From: Valentin Raevsky <valentin@compulab.co.il>
Date: Sun, 26 Jul 2026 23:40:26 +0300
Subject: [PATCH] compulab: dts: iotdin-imx8p: Remove unused reserved regions

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 arch/arm64/boot/dts/compulab/iotdin-imx8p.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/compulab/iotdin-imx8p.dts b/arch/arm64/boot/dts/compulab/iotdin-imx8p.dts
index e8c6420512f4..2dc8ba820bd7 100644
--- a/arch/arm64/boot/dts/compulab/iotdin-imx8p.dts
+++ b/arch/arm64/boot/dts/compulab/iotdin-imx8p.dts
@@ -8,7 +8,19 @@
 #include "ucm-imx8m-plus-pcie.dtsi"
 #include "sb-iotdimx8p.dtsi"
 
+/delete-node/ &gpu_reserved;
+/delete-node/ &dsp_reserved_heap;
+/delete-node/ &dsp_reserved;
+
 / {
 	model = "CompuLab IOTDIN-IMX8P";
 	compatible = "compulab,iotdin-imx8p", "compulab,iot-gate-imx8plus", "compulab,ucm-imx8m-plus-som", "fsl,imx8mp";
 };
+
+&mix_gpu_ml {
+	/delete-property/ memory-region;
+};
+
+&dsp {
+	/delete-property/ memory-region;
+};
-- 
